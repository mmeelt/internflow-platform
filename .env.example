# Copy to your local secret store or set these in the operating system.
# Never commit the real values.
DB_USERNAME=internflow_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=myappdb
DB_URL=jdbc:postgresql://localhost:5432/myappdb
JWT_SECRET=replace-with-base64-encoded-64-random-bytes
JWT_ISSUER=internflow-api
JWT_AUDIENCE=internflow-web
COOKIE_SECURE=false
# Enable only for the single startup that creates the first admin. Remove the
# password and set the flag to false immediately afterwards.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
BOOTSTRAP_ADMIN_NAME=System Administrator
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-mailbox
SMTP_PASSWORD=replace-with-app-password
MAIL_FROM=replace-with-verified-sender
NEXT_PUBLIC_API_URL=http://localhost:8081
# AI is disabled by default. Use real keys only in your local .env or a secret
# manager; do not paste them into the repository or chat.
AI_ENABLED=false
AI_PRIMARY_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional independent backup: create a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QDRANT_URL=http://qdrant:6333
AI_RAG_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Production uploads fail closed when the private ClamAV scanner is unavailable.
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_HOST=clamav
MALWARE_SCAN_PORT=3310
# Backups run at 02:15 UTC by default. They are stored in the private
# backup_data Docker volume; export that volume to encrypted off-site storage.
BACKUP_CRON=15 2 * * *
# Required for encrypted Restic backups. Use a long random passphrase and
# store it only in the company secret manager. The backup container refuses
# to write a backup if this value is missing.
RESTIC_REPOSITORY=/backups/restic
RESTIC_PASSWORD=replace-with-a-long-random-backup-passphrase
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
# Required only when using docker-compose.production.yml with Caddy and HTTPS.
APP_DOMAIN=app.example.com
